  liquid: lava/0.25
}
coolant: {
  liquid: superheated-steam/0.25
  multiplier: 2
}*/

requirements: [
  copper/1
]

shoot: {
  type: ShootPattern
  shots: 15
  shotDelay: 3
  firstShotDelay: 15
}

shoot: {
  type: ShootMulti
  source: {
    type: ShootPattern
    shots: 1
    shotDelay: 1
    firstShotDelay: 0
  }
  dest: [
    {
      type: ShootPattern
      shots: 5
      firstShotDelay: 15
      shotDelay: 4
    }
    {
      type: ShootPattern
      shots: 4
      firstShotDelay: 35
      shotDelay: 3
    }
    {
      type: ShootPattern
      shots: 3
      firstShotDelay: 47
      shotDelay: 2
    }
    {
      type: ShootPattern
      shots: 7
      firstShotDelay: 53
      shotDelay: 1
    }
  ]
}

shootCone: 10
inaccuracy: 15
shootSound: shootFlame

targetAir: false
targetGround: true

ammoPerShot: 3
displayAmmoMultiplier: true
consumeAmmoOnce: true
ammoTypes: {
  heat-cube: {
    type: LightningBulletType
    lightning: 1
    lightningAngle: 0
    lightningCone: 0
    lightningDamage: 8
    lightningLength: 15
    lightningLengthRand: 5
    
    lifetime: 15
    speed: 0
    collidesAir: false
    laserAbsorb: true
    laserBullet: true

    pierce: true
    pierceArmor: false
    pierceBuilding: false
    pierceCap: 4

    chargeEffect: [
      {
        type: ParticleEffect

        lifetime: 15
        clip: 200

        particles: 8
        spin: 1
        sizeFrom: 6
        sizeTo: 1
        sizeInterp: swingOut
        region: fire-forged-drill-spark

        baseLength: 180
        length: -180
        randLength: true
      }
      {
        type: WaveEffect

        lifetime: 15
        clip: 200

        sides: 16
        sizeFrom: 180
        sizeTo: 0
        interp: swingOut
        strokeFrom: 2
        strokeTo: 1
      }
    ]
  }
}